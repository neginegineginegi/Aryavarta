# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Raw third-party datasets stay out of the repo; manifests are committed.
data/raw/*
!data/raw/gem
data/raw/gem/*
!data/raw/gem/MANIFEST.md
# TCPD/LokDhaba drop (docs/ELECTIONS_INGEST_SPEC.md §1.2-1.3): blobs in
# ae/ ge/ early/ and the generated dry-run report stay local; the manifest,
# its template, and the captured terms are the committed record.
!data/raw/tcpd
data/raw/tcpd/*
!data/raw/tcpd/MANIFEST.csv
!data/raw/tcpd/MANIFEST.csv.example
!data/raw/tcpd/TERMS.md
!data/raw/tcpd/D3_FINDINGS.md
!data/raw/tcpd/STATE_ALIASES.csv
