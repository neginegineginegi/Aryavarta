# --- Database -------------------------------------------------------------
# Local dev: postgres://user:password@localhost:5432/abhilekh
# Neon (prod): use the POOLED connection string here...
DATABASE_URL="postgres://abhilekh:abhilekh_dev@127.0.0.1:5432/abhilekh"
# ...and the DIRECT (non-pooled) connection string here, used only by
# `pnpm db:migrate` (drizzle-kit). Optional locally.
DATABASE_URL_UNPOOLED=""
# 'neon' switches to the Neon serverless WebSocket driver (set this on Vercel).
# Any other value (or unset) uses node-postgres.
DATABASE_DRIVER="pg"

# --- Auth (Auth.js v5 + Google OAuth) --------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# (http://localhost:3000/api/auth/callback/google for local dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Bootstrap -------------------------------------------------------------
# The Google account with this email is promoted to admin on sign-in.
ADMIN_EMAIL=""

# --- Development only ------------------------------------------------------
# Enables a passwordless dev sign-in form on /login. NEVER set in production.
# AUTH_DEV_LOGIN="insecure-dev-mode"
