{
  "name": "abhilekh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "sharp@<0.35.0": "^0.35.0",
      "postcss@<8.5.18": "^8.5.18",
      "nanoid@<3.3.18": "^3.3.18"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-site-url.mjs && node scripts/check-auth-dev-login.mjs && node scripts/ensure-upgrades.mjs && tsx scripts/supersede-wikidata.ts && tsx scripts/load-inbox.ts && tsx scripts/load-funding-inbox.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed.ts --demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "load:inbox": "tsx scripts/load-inbox.ts",
    "supersede": "tsx scripts/supersede-wikidata.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "@svg-maps/india": "^2.0.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
